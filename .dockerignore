# Version control
.git
.github
.gitignore
.git-blame-ignore-revs

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info

# Node
node_modules
.npm

# Linting / editor config
.eslintrc
.editorconfig
.flake8
.pre-commit-config.yaml
.semgrepignore
.coderabbit.yml
.stylelintrc
sider.yml
